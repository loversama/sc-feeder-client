// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.voidlog.gg",
  // app code + node_modules in one app.asar: an update replaces one file instead of thousands of
  // loose ones (launching mid-update crashed with ERR_MODULE_NOT_FOUND). Native modules are
  // unpacked next to it (app.asar.unpacked). Keep asar on: see CLAUDE.md "Packaging rules".
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "node_modules/better-sqlite3/**",
    "node_modules/bindings/**",
    "node_modules/file-uri-to-path/**"
  ],
  "productName": "VOIDLOG.GG",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",          // Include built renderer code
    "dist-electron/**/*", // Include built main process code
    "package.json",
    "public/**/*"         // Include contents of the public directory (icons, sounds, etc.)
  ],
  // --- Add this publish block ---
  "publish": {
    "provider": "github",
    "owner": "loversama",
    "repo": "sc-feeder-client"
  },
  // -----------------------------
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "icon": "public/voidlog-icon.ico", // Specify the icon for Windows build
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      },
      {
        "from": "node_modules/electron/dist/libEGL.dll", 
        "to": "libEGL.dll"
      },
      {
        "from": "node_modules/electron/dist/libGLESv2.dll",
        "to": "libGLESv2.dll"
      }
    ]
  },
  "nsis": {
    // removes resources\app left by pre-asar installs (Electron would prefer it over app.asar)
    "include": "installer/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
